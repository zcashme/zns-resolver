# The complete SEV-SNP guest, built with StageX. Pass the resolver binaries as a
# named context and export with Buildx's local exporter:
#   docker buildx build -f Dockerfile.guest --platform linux/amd64 \
#     --build-context resolvers=<dir with zns-resolver-*-x86_64-linux-musl> \
#     --output type=local,dest=guest-release .
FROM stagex/user-elfutils@sha256:b5fc481f468dbab1d39bc3a2f2b256153cdcaf33e135abf41a2c5b5bea539151 AS elfutils
FROM stagex/core-openssl@sha256:f97827b11a98c010113e0d6acc464c77cbf6ea47a67867cfd1baff093bc5399a AS openssl
FROM stagex/core-ncurses@sha256:a5875ef06637624ead593724c43ab27be5fc7dbec5d292022bfe234896f584c1 AS ncurses
FROM stagex/core-libzstd@sha256:84c78c0000a4134df8a45661ab7e8ecb91dead720ff6b46c315380fb33cd0607 AS zstd
FROM stagex/core-busybox@sha256:a094d1b5ad06943713e75849248d7f89546d15a3e74f42ec5b8f02375fd3706d AS busybox
FROM stagex/user-caddy@sha256:f2ee0153fc2cb7c8fa017e982e1c48f9660bd76a1b650c8b4c710a1168bfc900 AS caddy
FROM stagex/core-ca-certificates@sha256:2e5d0da04413dfbc739f3009fe6616e90e733c463f8495ce6997b02c0832735c AS certificates
FROM stagex/user-snpguest@sha256:19069309be7c3cabeb87301535c913391359367cf68592a71ec8b2b88a5f2602 AS snpguest
FROM stagex/pallet-gcc-gnu-gnu@sha256:7c3726b921c4478d6eb95ab73edca3e185bc710e61005f4cf661267816fda0da AS gcc
FROM stagex/pallet-rust@sha256:4f12174acd7ccab9506e20a986c556cd5837dbd0ce616abf3031bcaaaa365590 AS rust

# Shared build tools: the GCC pallet plus the libraries its shell and coreutils load.
FROM gcc AS tools
COPY --from=elfutils / /
COPY --from=openssl / /
COPY --from=ncurses / /

# Linux from hash-pinned source; required drivers are built in, modules are off.
FROM tools AS kernel
ADD --checksum=sha256:f9fef3d14c0df53819026f4be74459835c2a0b0dcbf5b5bbd9ea19f0829402b3 https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.tar.xz /tmp/linux.tar.xz
ENV KBUILD_BUILD_USER=stagex KBUILD_BUILD_HOST=stagex KBUILD_BUILD_TIMESTAMP="Thu Jan 1 00:00:00 UTC 1970" KBUILD_BUILD_VERSION=1 SOURCE_DATE_EPOCH=0
WORKDIR /build
RUN --network=none <<'EOF'
set -eu
ln -s /bin/sh /bin/bash
tar -xJf /tmp/linux.tar.xz --strip-components=1
make ARCH=x86_64 tinyconfig
scripts/config \
 --enable 64BIT --enable EXPERT --enable PRINTK --enable BUG \
 --enable MULTIUSER --enable FUTEX --enable EPOLL --enable SIGNALFD --enable TIMERFD --enable EVENTFD \
 --enable FILE_LOCKING --enable POSIX_TIMERS --enable ADVISE_SYSCALLS --enable MEMBARRIER \
 --enable BINFMT_ELF --enable BINFMT_SCRIPT --disable COREDUMP \
 --enable PCI --enable PCI_MSI --enable ACPI \
 --enable CPU_SUP_AMD --enable SMP --enable HYPERVISOR_GUEST --enable PARAVIRT --enable KVM_GUEST \
 --enable AMD_MEM_ENCRYPT --enable VIRT_DRIVERS --enable SEV_GUEST \
 --enable EFI --enable EFI_STUB --enable RELOCATABLE --enable RANDOMIZE_BASE \
 --enable CPU_MITIGATIONS --enable STACKPROTECTOR --enable STACKPROTECTOR_STRONG --enable STRICT_KERNEL_RWX \
 --enable BLK_DEV_INITRD \
 --enable DEVTMPFS --enable DEVTMPFS_MOUNT --enable PROC_FS --enable SYSFS --enable SHMEM --enable TMPFS \
 --enable VIRTIO_MENU --enable VIRTIO --enable VIRTIO_PCI \
 --enable NET --enable NETDEVICES --enable NET_CORE --enable INET --enable UNIX --enable PACKET --enable VIRTIO_NET \
 --enable TTY --enable SERIAL_8250 --enable SERIAL_8250_CONSOLE \
 --enable UNWINDER_FRAME_POINTER --disable UNWINDER_ORC --disable MODULES --disable DEBUG_INFO \
 --disable LOCALVERSION_AUTO --set-str LOCALVERSION ''
make ARCH=x86_64 olddefconfig
for option in AMD_MEM_ENCRYPT SEV_GUEST TSM_REPORTS EFI_STUB BINFMT_SCRIPT BLK_DEV_INITRD DEVTMPFS TMPFS VIRTIO_PCI VIRTIO_NET INET SERIAL_8250_CONSOLE CPU_MITIGATIONS STACKPROTECTOR_STRONG STRICT_KERNEL_RWX; do
 grep -qx "CONFIG_${option}=y" .config || { echo "Required built-in missing: ${option}"; exit 1; }
done
grep -qx '# CONFIG_MODULES is not set' .config
grep -qx '# CONFIG_COREDUMP is not set' .config
make ARCH=x86_64 -j"$(nproc)" bzImage
gcc -O2 -o /usr/bin/gen_init_cpio usr/gen_init_cpio.c
EOF

# SNP firmware: a pinned Ubuntu OVMF build.
FROM tools AS firmware
COPY --from=zstd /usr/bin/zstd /usr/bin/zstd
COPY --from=zstd /usr/lib/libzstd.so.1 /usr/lib/libzstd.so.1
ADD --checksum=sha256:c38af8c8836ff73108ee449df9972381e9fcf47ab5e124ade836865f143691d6 https://archive.ubuntu.com/ubuntu/pool/main/e/edk2-hwe/ovmf-amdsev-hwe_2025.11-3ubuntu8.2_all.deb /tmp/ovmf.deb
WORKDIR /tmp/ovmf
RUN --network=none <<'EOF'
set -eu
ar x /tmp/ovmf.deb data.tar.zst
zstd -dc data.tar.zst | tar -xf - ./usr/share/ovmf/OVMF.amdsev.fd
mv usr/share/ovmf/OVMF.amdsev.fd /OVMF.amdsev.fd
echo 'a90ff0c9335690c8a82c89c71c71f082f7c8ed41bb6a4f017fbc90498092949b  /OVMF.amdsev.fd' | sha256sum -c -
EOF

# Uncompressed newc initramfs with fixed owners, modes and timestamps.
FROM kernel AS initramfs
ARG ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
COPY --from=busybox /usr/bin/busybox /rootfs/busybox
COPY --from=caddy /usr/bin/caddy /rootfs/caddy
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /rootfs/ca-certificates.crt
COPY --from=resolvers zns-resolver-mainnet-x86_64-linux-musl zns-resolver-testnet-x86_64-linux-musl /rootfs/
COPY guest/init guest/Caddyfile /rootfs/
WORKDIR /rootfs
RUN --network=none <<'EOF'
set -eu
for binary in busybox caddy zns-resolver-mainnet-x86_64-linux-musl zns-resolver-testnet-x86_64-linux-musl; do
 readelf --file-header "$binary" | grep -q 'Advanced Micro Devices X86-64'
 if readelf --program-headers "$binary" | grep -q INTERP; then echo "Not static: $binary"; exit 1; fi
done
sed -i "s#https://acme-v02.api.letsencrypt.org/directory#${ACME_DIRECTORY}#" Caddyfile
cat > list <<LIST
dir /bin 755 0 0
dir /dev 755 0 0
nod /dev/console 600 0 0 c 5 1
dir /data 755 0 0
dir /etc 755 0 0
dir /etc/caddy 755 0 0
dir /etc/ssl 755 0 0
dir /etc/ssl/certs 755 0 0
dir /proc 755 0 0
dir /run 755 0 0
dir /sys 755 0 0
dir /tmp 755 0 0
dir /usr 755 0 0
dir /usr/bin 755 0 0
file /init /rootfs/init 755 0 0
slink /bin/sh ../usr/bin/busybox 777 0 0
file /usr/bin/busybox /rootfs/busybox 755 0 0
file /usr/bin/caddy /rootfs/caddy 755 0 0
file /usr/bin/zns-resolver-mainnet-x86_64-linux-musl /rootfs/zns-resolver-mainnet-x86_64-linux-musl 755 0 0
file /usr/bin/zns-resolver-testnet-x86_64-linux-musl /rootfs/zns-resolver-testnet-x86_64-linux-musl 755 0 0
file /etc/caddy/Caddyfile /rootfs/Caddyfile 644 0 0
file /etc/ssl/certs/ca-certificates.crt /rootfs/ca-certificates.crt 644 0 0
LIST
gen_init_cpio -t 0 list > /resolver-initrd.img
EOF

# Launch measurement and host unit. Measurement and launch share these values.
FROM rust AS release
ARG VCPUS=2 MEMORY=4G POLICY=0x30000 GUEST_FEATURES=0x1
# snpguest measures named QEMU CPU models only; the unit launches the same model.
ARG CPU_TYPE=EPYC-Genoa
ARG CMDLINE="console=ttyS0 net.ifnames=0 rdinit=/init"
COPY --from=snpguest /usr/bin/snpguest /usr/bin/snpguest
COPY --from=kernel /build/arch/x86/boot/bzImage /out/vmlinuz
COPY --from=kernel /build/.config /out/kernel.config
COPY --from=firmware /OVMF.amdsev.fd /out/OVMF.amdsev.fd
COPY --from=initramfs /resolver-initrd.img /out/resolver-initrd.img
COPY guest/zns-resolver-guest.service.in /tmp/
WORKDIR /out
RUN --network=none <<'EOF'
set -eu
sed -e "s#@VCPUS@#${VCPUS}#" -e "s#@MEMORY@#${MEMORY}#" -e "s#@POLICY@#${POLICY}#" -e "s#@CMDLINE@#${CMDLINE}#" -e "s#@CPU_TYPE@#${CPU_TYPE}#" \
 /tmp/zns-resolver-guest.service.in > zns-resolver-guest.service
snpguest generate measurement --vmm-type QEMU --vcpus "$VCPUS" \
 --vcpu-type "$CPU_TYPE" \
 --guest-features "$GUEST_FEATURES" --ovmf OVMF.amdsev.fd --kernel vmlinuz --initrd resolver-initrd.img \
 --append "$CMDLINE" --output-format hex --measurement-file expected-snp-measurement.txt
measurement=$(tr -d '\n' < expected-snp-measurement.txt | sed 's/^0x//')
printf '%s\n' "$measurement" | grep -qxE '[0-9a-f]{96}' || { echo "Invalid measurement: $measurement"; exit 1; }
printf '%s\n' "$measurement" > expected-snp-measurement.txt
sha256sum vmlinuz kernel.config OVMF.amdsev.fd resolver-initrd.img zns-resolver-guest.service expected-snp-measurement.txt > SHA256SUMS
cat expected-snp-measurement.txt
EOF

FROM scratch AS guest
COPY --from=release /out/ /
