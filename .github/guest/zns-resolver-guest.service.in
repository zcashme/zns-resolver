[Unit]
Description=Mainnet and testnet ZNS resolver SEV-SNP guest
After=network-online.target
Wants=network-online.target
ConditionPathExists=/dev/sev

[Service]
Type=simple
WorkingDirectory=/opt/zns-resolver-guest
ExecStartPre=/usr/bin/sha256sum --check SHA256SUMS
ExecStart=/usr/bin/qemu-system-x86_64 -enable-kvm -machine q35,confidential-guest-support=sev0,vmport=off -cpu host -smp @VCPUS@ -m @MEMORY@ -object sev-snp-guest,id=sev0,cbitpos=51,reduced-phys-bits=1,policy=@POLICY@,kernel-hashes=on -bios /opt/zns-resolver-guest/OVMF.amdsev.fd -kernel /opt/zns-resolver-guest/vmlinuz -initrd /opt/zns-resolver-guest/resolver-initrd.img -append "@CMDLINE@" -netdev user,id=net0,hostfwd=tcp:0.0.0.0:80-10.0.2.15:80,hostfwd=tcp:0.0.0.0:443-10.0.2.15:443 -device virtio-net-pci,netdev=net0 -name zns-resolver -display none -serial stdio -monitor none -no-reboot
# Do not loop on boot errors: each successful boot can request new certificates.
Restart=no
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
